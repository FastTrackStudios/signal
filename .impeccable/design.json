      "css": ".ds-pane{background:#0e0e11;border:1px solid #222228;border-radius:8px;overflow:hidden;font:560 17px -apple-system,system-ui,sans-serif;color:#e4e4e7;}.ds-row{display:flex;align-items:center;justify-content:space-between;min-height:64px;padding:0 22px;}.ds-row+.ds-row{border-top:1px solid #222228;}.ds-row:hover{background:rgba(255,255,255,0.05);}.ds-row-up{background:#1b2331;font-weight:820;}.ds-up{position:relative;}.ds-up::after{content:'';position:absolute;left:0;right:0;bottom:-5px;height:3px;border-radius:2px;background:#22c55e;}.ds-lbl{font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#a1a1aa;}.ds-struck{text-decoration:line-through;text-decoration-color:#a1a1aa;text-decoration-thickness:3px;color:#80808a;}"
