// Cinematic Studio Brass — per-articulation signalpack grouping.
//
// Consumed by the pack builder (same format as cs-strings-packs.styx). Each
// group becomes one pack per (section, mic):
// `<Section> - <name> - <Mic>.signalpack` (+ `.proxy.signalpack` Ogg variant).
// `articulations` lists the RAW zone articulation ids folded into the group —
// release samples and legato transitions ship with their body articulation so
// every pack is a complete playable unit (note-on body, note-off release,
// legato handoff).
//
// The CSB sustain patch IS the legato patch (transitions play over sustains),
// so Sus/Susrel/Leg/Legzero land in one "Legato" group — exactly how CSB
// ships it. Brass has no vibrato pair and no portamento.
//
// The builder ERRORS on any zone articulation not claimed by a group (no
// silent drops). Not every group exists for every section — the census-backed
// availability (see cinematic-brass.styx instrument_filter):
//   trills           → trumpets, horns, tuba (NO trombones)
//   Mute*            → trumpets, trombones, Solo French Horn (NOT 4FH, Tuba)
//   Stopped*         → 4 French Horns only
//   Taka             → everything except Tuba
// Sections without a group's articulations simply produce no pack for it.

library "Cinematic Studio Brass"

groups (
    {
        name "Legato"
        articulations (Sus Susrel Leg Legzero)
    }
    {
        name "Marcato"
        articulations (Marcato Marcrel)
    }
    {
        name "Staccato"
        articulations (Staccato)
    }
    {
        name "Staccatissimo"
        articulations (Staccatissimo)
    }
    {
        name "Sforzando"
        articulations (Sfz)
    }
    {
        name "Flutter"
        articulations (Flutter Fluttrel)
    }
    {
        name "Half-Tone Trills"
        articulations (HTrills HTrel)
    }
    {
        name "Whole-Tone Trills"
        articulations (WTrills WTrel)
    }
    {
        name "Rips"
        articulations (Rips)
    }
    {
        name "Taka"
        articulations (Taka)
    }
    {
        name "Repetitions"
        articulations (Repetitions)
    }
    {
        name "Muted Sustain"
        articulations (Mutesus Mutesusrel)
    }
    {
        name "Muted Repetitions"
        articulations (Mutereps)
    }
    {
        // 4 French Horns only.
        name "Stopped Sustain"
        articulations (Stoppedsus Stoppedsusrel)
    }
    {
        // 4 French Horns only.
        name "Stopped Repetitions"
        articulations (Stoppedreps)
    }
)
