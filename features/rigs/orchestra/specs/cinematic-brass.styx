// Cinematic Studio Brass — Library Specification
//
// Ported from the legacy sample-collector spec (cinematic-brass.toml, manual
// derived) and corrected against GROUND TRUTH: the nki-styx zone census of the
// 8 extracted section patches (_patches/<section>/library.styx) plus the
// decoded engine persistents in CSB_CSW_ENGINE.md (real shipped values from
// _ksp/<instr>/persistent_1.tsv, not the compiled defaults).
//
// Intended to drive signal-sampler: patch building, keymap layout, legato
// engine, release triggering, and dynamic crossfade routing. Zones live in
// the per-section _patches specs; this file is the engine config only.

name    "Cinematic Studio Brass"
// version — not documented in the manual; capture from NKI metadata (TBD)
vendor  "Cinematic Studio"

// ── Sections ──────────────────────────────────────────────────────────────────
// Whole-tone grid rooted on A# (= Bb); sampler pitch-shifts ±1 semitone to
// fill. Labels MUST match the _patches directory names exactly.
// Ranges are from the zone census (root_key min/max per section, Kontakt
// note naming: C3 = MIDI 60) — the manual's blanket "A#1–G#3" was wrong.

sections (
    {
        id          2tb
        label       "2 Trombones"
        note_grid   (A# C D E F# G#)
        lowest_note  E1    // census: root keys 40–72
        highest_note C4
    }
    {
        id          2tpt
        label       "2 Trumpets"
        note_grid   (A# C D E F# G#)
        lowest_note  G#2   // census: root keys 56–84
        highest_note C5
    }
    {
        id          4fh
        label       "4 French Horns"
        note_grid   (A# C D E F# G#)
        lowest_note  E1    // census: root keys 40–76
        highest_note E4
    }
    {
        id          Sbtb
        label       "Solo Bass Trombone"
        note_grid   (A# C D E F# G#)
        lowest_note  E1    // census: root keys 40–72
        highest_note C4
    }
    {
        id          Sfh
        label       "Solo French Horn"
        note_grid   (A# C D E F# G#)
        lowest_note  E1    // census: root keys 40–76
        highest_note E4
    }
    {
        id          Stb
        label       "Solo Trombone"
        note_grid   (A# C D E F# G#)
        lowest_note  E1    // census: root keys 40–72
        highest_note C4
    }
    {
        id          Stpt
        label       "Solo Trumpet"
        note_grid   (A# C D E F# G#)
        lowest_note  G#2   // census: root keys 56–84
        highest_note C5
    }
    {
        id          Tub
        label       "Tuba"
        note_grid   (A# C D E F# G#)
        lowest_note  D1    // census: root keys 38–70
        highest_note A#3
    }
)

// ── Microphone Positions ──────────────────────────────────────────────────────
// 4 channels. Mix is the pre-baked stereo blend of Close + Main + Room
// (per manual). Ids match the zone `mic` values exactly.
//
// `default true` on Mix — only the pre-blended bus loads on open; the
// separate mics stay unloaded until explicitly requested (same RAM-saving
// convention as CSS).

mics (
    {id Mix,   label Mix,   kind blended,  default true}
    {id Close, label Close, kind separate}
    {id Main,  label Main,  kind separate}
    {id Room,  label Room,  kind separate}
)

// ── Performance model ─────────────────────────────────────────────────────────
// Only the values actually decoded for CSB are set; everything else keeps
// the engine defaults (which are the CSS-calibrated numbers — sustain
// makeup/note-off fade have NOT been A/B calibrated for CSB yet).

performance {
    release_ms           400   // CSB release "Length" knob = 400 on ALL instruments (CSB_CSW_ENGINE.md §3)
    zone_pitch_tolerance 2     // whole-tone grid → shift ±1..2 to fill
    // Same owner policy as CSS: fresh attacks START on the click; legato
    // transitions and shorts keep arrive-at-tick compensation.
    attack_placement     start_at_tick
}

// ── Dynamic Control Model ─────────────────────────────────────────────────────
// Long notes (Sus, Mutesus, Stoppedsus, Trills, Flutter, Marcato, Taka):
//   CC1 crossfades between sampled dynamic layers; velocity irrelevant.
// Short notes: CC1 selects the short-note TYPE; velocity picks the dynamic.
// Brass has NO vibrato dimension (no CC2 crossfade pair — unlike CSS/CSW).
// CC map decoded from the KSP persistents: CC1 = dynamics, CC11 = expression,
// CC58 = keyswitch, CC64 = sustain pedal (re-trigger) — same as CSS.

dynamics {
    sustain_controller    CC1
    short_note_controller velocity
    // Decoded per-articulation velocity→layer minimums exist in the CSB KSP
    // (pp/mp/f/fff mins = 1/1/44/95, the `*_min` persistent vars) but the
    // pp/mp overlap (both min 1) hasn't been disambiguated per articulation
    // yet, so shorts fall back to the even velocity split for now.
    // TODO: stage per-artic vel_thresholds once the `*_min` decode is firmed up.

    // CC1 crossfade zones. Layer-count keyed; labels match the artic
    // dynamics lists below. Ranges are the legacy manual-derived estimates
    // (NOT decoded from CC tables like CSS — assumption, widened overlaps).
    // 2 layers — Flutter (p/ff).
    cc1_layers_2 (
        {label p,  cc_range (0  70)}
        {label ff, cc_range (56 127)}
    )
    // 3 layers — trills, muted/stopped longs, Taka, 3-dyn sustains (p/mf/ff).
    cc1_layers_3 (
        {label p,  cc_range (0  42)}
        {label mf, cc_range (33 94)}
        {label ff, cc_range (85 127)}
    )
    // 4 layers — the full sustain/legato set (p/mf/f/fff).
    cc1_layers_4 (
        {label p,   cc_range (0  31)}
        {label mf,  cc_range (22 73)}
        {label f,   cc_range (64 104)}
        {label fff, cc_range (95 127)}
    )

    // CC1 selects short-note sub-type when in the shorts group (manual).
    // Repetitions replaces CSS's Spiccato in the bottom band.
    short_note_cc1_map {
        0-31   Repetitions
        32-63  Staccatissimo
        64-95  Staccato
        96-127 Sfz
    }
}

// ── Articulations ─────────────────────────────────────────────────────────────
// Ids match the zone `articulation` tokens exactly (zone census verified).
// Dynamics lists are the MODAL per-section sets from the census; where
// sections differ the variance is commented — the sample map simply has no
// entry for a missing (section, dynamic) combo.
// `instrument_filter` = census-verified presence (corrects the old toml:
// Stopped* ships ONLY in "4 French Horns" — the Solo horn gets Mute* instead;
// trombones have no trills; Tuba has no mutes and no Taka).

articulations (

    // ── Sustains ────────────────────────────────────────────────────────────

    {
        id            Sus
        label         Sustain
        kind          @Sustain
        // Modal set. Census variance: 2Tb/Tuba = (p mf ff); Sbtb = (p mf fff);
        // Stpt = (p mf f ff).
        dynamics      (p mf f fff)
        rr            1
        dyn_ctrl      cc1
        release_artic Susrel
        notes         full
    }
    {
        id            Mutesus
        label         "Muted Sustain (Straight Mute)"
        kind          @Sustain
        dynamics      (p mf ff)
        rr            1
        dyn_ctrl      cc1
        release_artic Mutesusrel
        notes         full
        // Census: absent from 4 French Horns (they get Stopped* instead) and Tuba.
        instrument_filter (2tb 2tpt Sbtb Sfh Stb Stpt)
    }
    {
        id            Stoppedsus
        label         "Stopped Sustain"
        kind          @Sustain
        dynamics      (p mf ff)   // census confirmed (was TBD in the toml)
        rr            1
        dyn_ctrl      cc1
        release_artic Stoppedsusrel
        notes         full
        // Census: ONLY the 4 French Horns patch ships Stopped* (the toml's
        // "4fh + Sfh" was wrong — the Solo horn ships Mute* instead).
        instrument_filter (4fh)
    }
    {
        id            Flutter
        label         "Flutter Tongue"
        kind          @Sustain
        dynamics      (p ff)
        rr            1
        dyn_ctrl      cc1
        release_artic Fluttrel
        notes         full
    }
    {
        id            Marcato
        label         Marcato
        // Long-note class in CSB: legato-capable per the manual, CC1 dynamics,
        // paired release — unlike CSS where Marcato is a velocity short.
        kind          @Sustain
        dynamics      (mf f fff)   // census: mf/f/fff (2Tb lacks mf; Stb adds ff)
        rr            2            // ensembles 2 RR; solos ship 1 (census)
        dyn_ctrl      cc1
        release_artic Marcrel
        notes         full
    }

    // ── Trills ──────────────────────────────────────────────────────────────
    // Trigger: two notes played within ≤25 ms (same convention as CSS);
    // the interval selects half- vs whole-tone.

    {
        id            HTrills
        label         "Half-Tone Trills"
        kind          @Trill
        dynamics      (p mf ff)
        rr            1
        dyn_ctrl      cc1
        release_artic HTrel
        notes         full
        // Census: no trills on any trombone.
        instrument_filter (2tpt 4fh Sfh Stpt Tub)
    }
    {
        id            WTrills
        label         "Whole-Tone Trills"
        kind          @Trill
        dynamics      (p mf ff)
        rr            1
        dyn_ctrl      cc1
        release_artic WTrel
        notes         full
        instrument_filter (2tpt 4fh Sfh Stpt Tub)
    }

    // ── Legato / Transitions ────────────────────────────────────────────────
    // The transition-over-sustain ("CSS_W") handoff drives CSB too.
    // The numeric filename suffix on Leg is the transition INTERVAL in
    // semitones, not a round-robin index (census: rr_index is always 0 —
    // the toml's rr=12 misread the interval count).

    {
        id          Leg
        label       Legato
        kind        @Legato
        dynamics    (p mf f fff)   // census; 2Tb/Tuba = (p mf ff), Sbtb = (p mf fff)
        rr          1
        dyn_ctrl    cc1
        directional true
        notes       full
        legato_role transition
    }
    {
        id          Legzero
        label       "Legato Re-trigger"
        kind        @Legato
        dynamics    (p mf f fff)   // census; 2Tb/Tuba = (p mf ff), Sbtb = (p mf fff)
        rr          3
        dyn_ctrl    cc1
        directional false
        notes       full
        legato_role retrigger
    }

    // ── Short Notes ─────────────────────────────────────────────────────────

    {
        id       Staccato
        label    Staccato
        kind     @Short
        dynamics (pp mp f fff)
        rr       4
        dyn_ctrl velocity
        notes    full
    }
    {
        id       Staccatissimo
        label    Staccatissimo
        kind     @Short
        dynamics (pp mp f fff)
        rr       5
        dyn_ctrl velocity
        notes    full
    }
    {
        id       Sfz
        label    Sforzando
        kind     @Short
        dynamics (mf f fff)
        rr       2
        dyn_ctrl velocity
        notes    full
    }
    {
        id       Repetitions
        label    "Repetitions (Double Tongue)"
        kind     @Short
        // Modal census set; several sections add mf and/or ff on top
        // (2Tb has all six pp/mp/mf/f/ff/fff — the toml's 6-layer claim
        // holds only there).
        dynamics (pp mp f fff)
        rr       7
        dyn_ctrl velocity
        notes    full
    }
    {
        id       Mutereps
        label    "Muted Short Notes"
        kind     @Short
        // Modal census set (p/mf/ff); 2 Trombones ships pp/mp/f/fff instead.
        dynamics (p mf ff)
        rr       5
        dyn_ctrl velocity
        notes    full
        instrument_filter (2tb 2tpt Sbtb Sfh Stb Stpt)
    }
    {
        id       Stoppedreps
        label    "Stopped Short Notes"
        kind     @Short
        dynamics (p mf ff)   // census confirmed (was TBD in the toml)
        rr       5           // census confirmed (was TBD)
        dyn_ctrl velocity
        notes    full
        instrument_filter (4fh)
    }
    {
        id       Taka
        label    "Double Tongue (Taka)"
        kind     @Short
        dynamics (p mf ff)
        rr       24          // census rr_index 0–23 (the toml's 16 was low)
        dyn_ctrl cc1
        notes    full
        // Census: Tuba ships no Taka.
        instrument_filter (2tb 2tpt 4fh Sbtb Sfh Stb Stpt)
        // Tempo-syncable phrase engine in the vendor instrument (2–9
        // repetitions, X = manual mode) — we expose the raw one-shots only;
        // phrase-engine behaviour is a player concern, not spec data.
    }
    {
        id       Rips
        label    "Rips (Upward Glissando)"
        kind     @Short
        // Zone census: the `dynamic` field on Rips zones carries the gliss
        // TARGET note name (e.g. "A#2"), not a dynamic layer — declared
        // empty here; playback selects by key only.
        dynamics ()
        rr       1
        dyn_ctrl fixed
        notes    short   // reduced ranges per section (census)
    }

    // ── Release Samples ─────────────────────────────────────────────────────
    // Triggered on note-off; dynamic selected by CC1 at the moment of
    // note-off; single sample per note per dynamic (rr 1). Releases are ON
    // ($4p5kj = 1) for every CSB instrument.

    {
        id       Susrel
        label    "Sustain Release"
        kind     @Release
        dynamics (p mf f fff)   // mirrors Sus (census; 2Tb/Tuba 3-layer)
        rr       1
        dyn_ctrl cc1
        notes    full
    }
    {
        id       Marcrel
        label    "Marcato Release"
        kind     @Release
        dynamics (mf f fff)
        rr       1
        dyn_ctrl cc1
        notes    full
    }
    {
        id       Mutesusrel
        label    "Muted Sustain Release"
        kind     @Release
        dynamics (p mf ff)
        rr       1
        dyn_ctrl cc1
        notes    full
        instrument_filter (2tb 2tpt Sbtb Sfh Stb Stpt)
    }
    {
        id       Stoppedsusrel
        label    "Stopped Sustain Release"
        kind     @Release
        dynamics (p mf ff)
        rr       1
        dyn_ctrl cc1
        notes    full
        instrument_filter (4fh)
    }
    {
        id       Fluttrel
        label    "Flutter Tongue Release"
        kind     @Release
        dynamics (p ff)
        rr       1
        dyn_ctrl cc1
        notes    full
    }
    {
        id       HTrel
        label    "Half-Tone Trill Release"
        kind     @Release
        dynamics (p mf ff)
        rr       1
        dyn_ctrl cc1
        notes    full
        instrument_filter (2tpt 4fh Sfh Stpt Tub)
    }
    {
        id       WTrel
        label    "Whole-Tone Trill Release"
        kind     @Release
        dynamics (p mf ff)
        rr       1
        dyn_ctrl cc1
        notes    full
        instrument_filter (2tpt 4fh Sfh Stpt Tub)
    }
)

// ── Legato Engine ─────────────────────────────────────────────────────────────
// CSB has ONE legato mode (no Expressive/Low-Latency split) → flat `zones`.
// Values are the REAL shipped persistents (CSB_CSW_ENGINE.md §2–4):
//   velocity splits $eluxs/$0uhls = 64/100 on every instrument;
//   delay anchors Time A/B/C = 0 / 60–100 / 200–500 ms per velocity zone
//   (direction INVERTED vs CSS: low velocity = immediate, high = delayed),
//   plus Time D = 400–500 ms for intervals > 12 semitones (not expressible
//   in the flat-zone model yet — noted below).
// Per-instrument Time B/C/D + F.wait table (uniform: Time A=0, LT offsets
// 0/83/166, Fade-old 800, Timer 250):
//   2 Trombones        B 60  C 200 D 500  F.wait 1000  FadeIn 1000 FadeOut 300
//   2 Trumpets         B 100 C 200 D 500  F.wait 2100  FadeIn 500  FadeOut 250
//   4 French Horns     B 60  C 200 D 500  F.wait 1600  FadeIn 500  FadeOut 400
//   Solo Bass Trombone B 60  C 200 D 500  F.wait 600   FadeIn 750  FadeOut 280
//   Solo French Horn   B 100 C 500 D 500  F.wait 2100  FadeIn 500  FadeOut 300
//   Solo Trombone      B 100 C 300 D 400  F.wait 650   FadeIn 500  FadeOut 300
//   Solo Trumpet       B 60  C 200 D 500  F.wait 2100  FadeIn 500  FadeOut 250
//   Tuba               B 60  C 200 D 500  F.wait 1500  FadeIn 500  FadeOut 280
// The spec is per-LIBRARY, so the zones below carry the MODAL values
// (B=60, C=200); per-instrument specialization needs per-section legato
// blocks (future work — see CSB_CSW_ENGINE.md §6).

legato_engine {
    zones (
        {vel_range (0   64),  label immediate, delay_ms 0}     // Time A — all instruments
        {vel_range (65  100), label medium,    delay_ms 60}    // Time B (modal; 100 on 2Tpt/SFH/STb)
        {vel_range (101 127), label slow,      delay_ms 200}   // Time C (modal; up to 500 on SFH)
    )
    // Time D (interval > 12 semitones) = 400–500 ms — needs the
    // interval-gated 4th zone the flat model doesn't carry yet. TBD.

    // NO portamento in CSB (no portamento samples shipped) — block omitted.

    // REPEATED NOTES (Legzero): CC64 held + same note re-played, 3 RR.
    retrigger {
        trigger sustain_pedal_held
        rr      3
    }

    // Attack-velocity splits $eluxs/$0uhls — shipped 64/100 everywhere
    // (script default is 64/85; the real ship is 64/100).
    velocity_splits (64 100)

    // ASSUMED mapping of the decoded CSS_W handoff values onto our fade
    // model (approximate — same seam CSS uses):
    //   Fade in ($m0nme, legtrans fade-out, 500 modal) → transition_fade_ms
    //   Fade out ($mhmq3, outgoing fade, 250–400)      → retire_transition_ms
    //   Fade old ($ve35s/$mdsyv, 800 all)              → retire_sustain_ms
    transition_fade_ms   500
    retire_transition_ms (300 300 300)
    retire_sustain_ms    (800 800 800)

    // LT sample-start offsets — uniform 0/83/166 ms per velocity range on
    // every CSB instrument. One mode only, so both tables get the same
    // values (whichever the engine consults for flat-zone libraries).
    lt_offset_expressive  (0 83 166)
    lt_offset_low_latency (0 83 166)
}

// ── Short Note Timing ─────────────────────────────────────────────────────────
// All short-note samples have a 60 ms pre-delay before the rhythmic peak
// (exact from the manual; same as CSS/CSW).

short_note_timing {
    pre_delay_ms 60
}

// ── Keyswitch / CC58 Switching ────────────────────────────────────────────────
// Velocity-sensitive keyswitches; MIDI note assignments are user-configurable
// with no documented default layout, so no `notes` block is authored (unlike
// CSS where the defaults are known). CC58 ranges are exact from the manual.
// KS velocity splits (manual): Staccato KS 0-32→Repetitions / 33-64→
// Staccatissimo / 65-96→Staccato / 97-127→Sfz; Muted KS 0-64→Mutereps /
// 65-127→Mutesus; Marcato KS 0-64/65-127→repetition overlay off/on;
// Legato KS 0-64/65-127→off/on.

keyswitch {
    velocity_sensitive true
    user_configurable  true

    cc58_map {
        0-10  Sustain
        11-15 Repetitions
        16-20 Staccatissimo
        21-25 Staccato
        26-30 Sfz
        31-40 "Muted short notes (Mutereps)"
        41-45 Rips
        46-50 Trills
        51-55 "Flutter Tongue"
        56-60 "Muted long notes (Mutesus)"
        61-65 "Double Tongue (Taka)"
        66-70 "Marcato (no overlay)"
        71-75 "Marcato (with overlay)"
        76-80 "Legato On"
        81-85 "Legato Off"
    }
}
