// Pacific - Solo Strings — pack grouping (prefix matching, longest prefix
// wins). Performance-legato family (sus/atk/rel/rep + legslur/legbow/
// legport transitions) = one "Legato" unit per instrument.

library "Pacific - Solo Strings"

groups (
    {
        name "Legato"
        prefixes (sus atk rel rep leg)
    }
    {
        name "Marcato"
        prefixes (marc)
    }
    {
        name "Tremolo"
        prefixes (trem)
    }
    {
        name "Harmonics"
        prefixes (harm)
    }
    {
        name "Pizzicato"
        prefixes (pizz)
    }
    {
        name "Spiccato"
        prefixes (spicc)
    }
    {
        name "Staccato"
        prefixes (stacc)
    }
)
