// Cinematic Studio Woodwinds — per-articulation signalpack grouping.
//
// Consumed by `signal-sampler --example build_cs_packs`. Each group becomes
// one pack per (section, mic): `<Section> - <name> - <Mic>.signalpack`
// (+ `.proxy.signalpack` Ogg Vorbis variant). `articulations` lists the RAW
// zone articulation ids folded into the group — release samples and legato
// transitions ship with their body articulation so every pack is a complete
// playable unit (note-on body, note-off release, legato handoff).
//
// Vibsus/NVsus are a CC2 crossfade pair and must stay together; the CSW
// sustain patch IS the legato patch (transitions play over sustains), so the
// whole sustain+legato family — both vibrato sides, both re-trigger sets, and
// the MLeg marcato-legato transitions — lands in one "Legato" group, exactly
// how CSW ships it. Clarinet-family sections have no Vib*/Leg/Legzero zones
// (NV-only) and the flute-only Flutter group simply doesn't build for
// non-flute sections — missing articulations in a section are fine; only
// UNCLAIMED articulations are an error.
//
// The builder ERRORS on any zone articulation not claimed by a group
// (no silent drops). Keyswitch/CC58 tables in the engine config reference
// articulations across groups; entries pointing outside a pack are inert.

library "Cinematic Studio Woodwinds"

groups (
    {
        name "Legato"
        articulations (Vibsus Vibsusrel NVsus NVsusrel Leg Legzero NVLeg NVLegzero MLeg)
    }
    {
        name "Marcato"
        articulations (Marcato Marcrel)
    }
    {
        name "Staccato"
        articulations (Staccato)
    }
    {
        name "Staccatissimo"
        articulations (Staccatissimo)
    }
    {
        name "Sforzando"
        articulations (Sfz)
    }
    {
        // Flutes/alto flute/piccolo only (2 Flutes, Saf, Solo Flute, Spi).
        name "Flutter"
        articulations (Flutter Fluttrel)
    }
    {
        name "Half-Tone Trills"
        articulations (HTrills HTrel)
    }
    {
        name "Whole-Tone Trills"
        articulations (WTrills WTrel)
    }
    {
        name "Repetitions"
        articulations (Repetitions)
    }
)
