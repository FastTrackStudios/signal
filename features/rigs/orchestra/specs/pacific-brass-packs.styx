// Pacific - Brass — pack grouping. Articulation ids carry baked-in
// release-variant/RR suffixes (normrel4, normrep2.5, rel3 …), so groups
// match by PREFIX (longest prefix wins). The "Normal" performance-legato
// family (sustain + time-variant releases + repetitions) is one playable
// unit; Flutter Tongue is its own colour. Tuba ships plain sus/rel/rep ids
// (no "norm" prefix) — covered by the same group.

library "Pacific - Brass"

groups (
    {
        name "Normal"
        prefixes (norm sus rel rep atk leg)
    }
    {
        name "Flutter"
        prefixes (flutter)
    }
)
