// Cinematic Studio Solo Strings — per-articulation signalpack grouping.
//
// Consumed by `signal-sampler --example build_cs_packs`. Each group becomes
// one pack per (section, mic): `<Section> - <name> - <Mic>.signalpack`
// (+ `.proxy.signalpack` Ogg Vorbis variant). `articulations` lists the RAW
// zone articulation ids folded into the group — release samples and legato
// transitions ship with their body articulation so every pack is a complete
// playable unit (note-on body, note-off release, legato handoff).
//
// Vibsus/Nonvib are the CC2 vibrato pair (on/off in this library, but the
// engine still needs both loaded to switch); the sustain patch IS the legato
// patch (transitions play over sustains), so the whole family lands in one
// "Legato" group — exactly how the vendor ships it. Mirrors the CSS grouping.
//
// The builder ERRORS on any zone articulation not claimed by a group
// (no silent drops). Keyswitch/CC58 tables in the engine config reference
// articulations across groups; entries pointing outside a pack are inert.
//
// Sections: "Solo Violin", "Solo Violin II", "Solo Viola", "Solo Cello";
// mics: Mix (pre-blended), Close, Main, Room.

library "Cinematic Studio Solo Strings"

groups (
    {
        // Non-vibrato sustain token split (zone-map confirmed): Solo Violin
        // zones say "Nonvib"; Solo Violin II / Viola / Cello say "NVsus".
        // Both raw ids are claimed here — same idiom as CSS's Pizzicato/Pizz.
        name "Legato"
        articulations (Vibsus Nonvib NVsus Vsusrel NVrel Leg Legzero NVLeg NVLegzero Port)
    }
    {
        name "Tremolo"
        articulations (Tremolo Tremrel)
    }
    {
        name "Half-Tone Trills"
        articulations (HTrills HTrel)
    }
    {
        name "Whole-Tone Trills"
        articulations (WTrills WTrel)
    }
    {
        name "Harmonics"
        articulations (Harm Harmrel)
    }
    {
        name "Col Legno"
        articulations (Clegno)
    }
    {
        name "Staccato"
        articulations (Staccato)
    }
    {
        name "Staccatissimo"
        articulations (Staccatissimo)
    }
    {
        name "Spiccato"
        articulations (Spiccato)
    }
    {
        name "Marcato"
        articulations (Marcato Marcrel)
    }
    {
        name "Sforzando"
        articulations (Sfz)
    }
    {
        // All four instruments use the "Pizzicato" token — no "Pizz" alias
        // exists in this library (unlike CSS).
        name "Pizzicato"
        articulations (Pizzicato)
    }
    {
        name "Bartok Pizzicato"
        articulations (Bartokpizz)
    }
)
