// Cinematic Studio Woodwinds — Library Specification
//
// Engine config for signal-sampler (no zones — the per-section zone maps live
// in `<lib_root>/_patches/<Section>/library.styx`, generated by nki-styx).
// Drives patch building, keymap layout, legato engine, release triggering,
// and dynamic crossfade routing.
//
// Sources:
// - legacy sample-collector spec (cinematic-winds.toml) — manual-derived model
// - CSB_CSW_ENGINE.md — REAL shipped KSP persistent values (all 13 instruments)
// - the 13 nki-styx zone specs — ground-truth articulations/dynamics/RR/ranges

name    "Cinematic Studio Woodwinds"
// version: not documented in the manual and not yet captured from NKI
// metadata — left empty (spec default).
vendor  "Cinematic Studio"

// ── Sections ──────────────────────────────────────────────────────────────────
// 13 instruments. Whole-tone grid rooted on A# (every 2 semitones); the
// sampler pitch-shifts ±1 semitone to fill the gaps. A stray edge note (A)
// appears at some range boundaries — covered by zone-mode key ranges.
//
// Labels match the `_patches/` directory names EXACTLY (the pack builder and
// zone specs key on them). Ranges are the sampled root-key extents from the
// zone specs (Kontakt naming, C3 = MIDI 60).

sections (
    {
        id          2ba
        label       "2 Bassoons"
        note_grid   (A# C D E F# G#)
        lowest_note  A#0
        highest_note D4
    }
    {
        id          2cl
        label       "2 Clarinets"
        note_grid   (A# C D E F# G#)
        lowest_note  D2
        highest_note E5
    }
    {
        id          2fl
        label       "2 Flutes"
        note_grid   (A# C D E F# G#)
        lowest_note  C3
        highest_note C6
    }
    {
        id          2ob
        label       "2 Oboes"
        note_grid   (A# C D E F# G#)
        lowest_note  A#2
        highest_note F#5
    }
    {
        // Solo Alto Flute
        id          Saf
        label       Saf
        note_grid   (A# C D E F# G#)
        lowest_note  G2
        highest_note C#5
    }
    {
        // Solo Bass Clarinet
        id          Sbc
        label       Sbc
        note_grid   (A# C D E F# G#)
        lowest_note  A#0
        highest_note D4
    }
    {
        // Solo Cor Anglais (English horn — NOT "Solo Clarinet A" as the
        // legacy toml guessed)
        id          Sca
        label       Sca
        note_grid   (A# C D E F# G#)
        lowest_note  E2
        highest_note A#4
    }
    {
        // Solo Contra Bassoon (NOT "Solo Clarinet B" as the legacy toml guessed)
        id          Scb
        label       Scb
        note_grid   (A# C D E F# G#)
        lowest_note  A#0
        highest_note A#3
    }
    {
        id          Sba
        label       "Solo Bassoon"
        note_grid   (A# C D E F# G#)
        lowest_note  A#0
        highest_note D4
    }
    {
        id          Scl
        label       "Solo Clarinet"
        note_grid   (A# C D E F# G#)
        lowest_note  D2
        highest_note E5
    }
    {
        id          Sfl
        label       "Solo Flute"
        note_grid   (A# C D E F# G#)
        lowest_note  C3
        highest_note C6
    }
    {
        id          Sob
        label       "Solo Oboe"
        note_grid   (A# C D E F# G#)
        lowest_note  A#2
        highest_note F#5
    }
    {
        // Solo Piccolo
        id          Spi
        label       Spi
        note_grid   (A# C D E F# G#)
        lowest_note  D3
        highest_note C6
    }
)

// ── Microphone Positions ───────────────────────────────────────────────────────
// 5 channels (mic ids exactly as in the zone specs). Mix is the vendor's
// pre-baked stereo blend of the other four (Close + OH + Room + Main).
//
// `default true` on Mix only — same RAM policy as CSS: the pre-blended bus is
// the only mic that loads on open; the separates stay unloaded until requested.

mics (
    {id Mix,   label Mix,      kind blended,  default true}
    {id Close, label Close,    kind separate}
    {id Main,  label Main,     kind separate}
    {id OH,    label Overhead, kind separate}
    {id Room,  label Room,     kind separate}
)

// ── Dynamic Control Model ─────────────────────────────────────────────────────
// Longs:   CC1 crossfades between sampled dynamic layers. Velocity irrelevant
//          for layer selection (but see sustain_attack_velocity).
// Vibrato: CC2 crossfade between the vibrato/non-vibrato pair (Vibsus↔NVsus,
//          Leg↔NVLeg, Legzero↔NVLegzero) — same model as CSS Vibsus/Nonvib.
//          Clarinet-family sections ship NO vibrato set (classical practice);
//          those sections have only the NV* side (see instrument_filter).
// Shorts:  CC1 selects the short-note TYPE; velocity selects the dynamic
//          within it (manual model — CSW's KSP short-velocity tables have NOT
//          been decoded, so enable_velocity_layers stays off and the engine
//          even-splits velocity across the listed dynamics).

dynamics {
    sustain_controller    CC1
    vibrato_controller    CC2
    short_note_controller velocity

    // CSW-specific (manual): sustain note-on velocity picks the attack
    // character. Documented model only — no separate attack sample set exists
    // in the zone specs; treat as an engine hint.
    sustain_attack_velocity {
        0-64   "normal attack"
        65-127 "accented attack"
    }

    // Two-layer crossfade — used by Flutter (p/f). Ranges are an ASSUMPTION
    // modeled on the CSS 2-layer widths (wide overlap); not decoded from KSP.
    cc1_layers_2 (
        {label p, cc_range (0  70)}
        {label f, cc_range (56 127)}
    )
    // Three-layer crossfade (p/mf/ff — the dominant CSW long/legato/trill/
    // short set). Ranges from the legacy manual-derived spec, not KSP-decoded.
    // NOTE: Marcato ships p/mf/fff — its top label ("fff") does not match this
    // set's "ff" slot, so the sample map falls back at high CC1 (same known
    // limitation as CSS Marcrel). Revisit if a per-articulation layer set
    // lands in DynamicsSpec.
    cc1_layers_3 (
        {label p,  cc_range (0  42)}
        {label mf, cc_range (33 94)}
        {label ff, cc_range (85 127)}
    )
    // Four-layer split — used by ensemble Repetitions (pp/mp/f/fff,
    // velocity-driven; the ranges only matter if a cc1-driven 4-layer
    // articulation appears). From the legacy spec.
    cc1_layers_4 (
        {label pp,  cc_range (0  31)}
        {label mp,  cc_range (22 73)}
        {label f,   cc_range (64 104)}
        {label fff, cc_range (95 127)}
    )

    // CC1 selects the short-note sub-type (manual; CSW replaces CSS's
    // Spiccato slot with Repetitions).
    short_note_cc1_map {
        0-31   Repetitions
        32-63  Staccatissimo
        64-95  Staccato
        96-127 Sfz
    }

    // enable_velocity_layers / vel_thresholds intentionally absent: the CSW
    // per-articulation %g1qri/%bcez1 tables have not been decoded from the
    // persistent values yet. Even velocity split until then.
}

// ── Articulations ─────────────────────────────────────────────────────────────
// Ground truth: the union of `articulation` values across the 13 zone specs.
// Dynamics/RR are the consensus from the zone specs; per-section variance is
// commented (the sample map returns None for missing combos → no crash).

articulations (

    // ── Sustains ────────────────────────────────────────────────────────────

    {
        id            Vibsus
        label         "Vibrato Sustain"
        kind          @Sustain
        dynamics      (p mf ff)
        rr            1
        dyn_ctrl      cc1
        release_artic Vibsusrel
        notes         full
        vibrato       true
        vibrato_pair  NVsus
        // Absent from the clarinet family (2 Clarinets / Solo Clarinet /
        // Bass Clarinet / Contra Bassoon) — those sections are NV-only.
        // Both ids and labels listed so the filter matches whichever the
        // engine carries as its section key.
        instrument_filter (2ba "2 Bassoons" 2fl "2 Flutes" 2ob "2 Oboes"
                           Saf Sba "Solo Bassoon" Sca Sfl "Solo Flute"
                           Sob "Solo Oboe" Spi)
    }
    {
        id            NVsus
        label         "Non-Vibrato Sustain"
        kind          @Sustain
        dynamics      (p mf ff)   // Solo Oboe ships only p/ff
        rr            1
        dyn_ctrl      cc1
        release_artic NVsusrel
        notes         full
        vibrato       false
        vibrato_pair  Vibsus
    }
    {
        id            Flutter
        label         "Flutter Tongue"
        kind          @Sustain
        dynamics      (p f)
        rr            1
        dyn_ctrl      cc1
        release_artic Fluttrel
        notes         full
        // Flutes only (2 Flutes / Alto Flute / Solo Flute / Piccolo) —
        // confirmed by the zone specs.
        instrument_filter (2fl "2 Flutes" Saf Sfl "Solo Flute" Spi)
        vibrato_pair  ""   // no CC2 partner — flutter is its own colour
    }
    {
        // Legato-capable long marcato (manual). Ships p/mf/fff — see the
        // cc1_layers_3 label caveat above for the fff slot.
        id            Marcato
        label         Marcato
        kind          @Sustain
        dynamics      (p mf fff)
        rr            1
        dyn_ctrl      cc1
        release_artic Marcrel
        notes         full
        vibrato_pair  ""   // recorded one way; no vib/NV pairing
    }

    // ── Trills ──────────────────────────────────────────────────────────────
    // Trigger convention (manual): two notes struck within ≤25 ms; the
    // interval picks HT vs WT. (No dedicated spec field — engine convention.)

    {
        id            HTrills
        label         "Half-Tone Trills"
        kind          @Trill
        dynamics      (p mf ff)
        rr            1
        dyn_ctrl      cc1
        release_artic HTrel
        notes         full
    }
    {
        id            WTrills
        label         "Whole-Tone Trills"
        kind          @Trill
        dynamics      (p mf ff)
        rr            1
        dyn_ctrl      cc1
        release_artic WTrel
        notes         full
    }

    // ── Legato / Transitions ─────────────────────────────────────────────────
    // Direction (up/down) is encoded per zone; the filename interval suffix is
    // the transition INTERVAL in semitones, not a round-robin index (CSS
    // lesson — the legacy toml's "rr = 12" was that misreading; real rr = 1).
    // Only the *zero re-trigger sets have real RRs (3).

    {
        id          Leg
        label       "Vibrato Legato"
        kind        @Legato
        dynamics    (p mf ff)
        rr          1
        dyn_ctrl    cc1
        directional true
        notes       full
        vibrato      true
        vibrato_pair NVLeg
        legato_role  transition
        instrument_filter (2ba "2 Bassoons" 2fl "2 Flutes" 2ob "2 Oboes"
                           Saf Sba "Solo Bassoon" Sca Sfl "Solo Flute"
                           Sob "Solo Oboe" Spi)
    }
    {
        id          Legzero
        label       "Vibrato Legato Re-trigger"
        kind        @Legato
        dynamics    (p mf ff)
        rr          3
        dyn_ctrl    cc1
        directional false
        notes       full
        vibrato      true
        vibrato_pair NVLegzero
        legato_role  retrigger
        instrument_filter (2ba "2 Bassoons" 2fl "2 Flutes" 2ob "2 Oboes"
                           Saf Sba "Solo Bassoon" Sca Sfl "Solo Flute"
                           Sob "Solo Oboe" Spi)
    }
    {
        id          NVLeg
        label       "Non-Vibrato Legato"
        kind        @Legato
        dynamics    (p mf ff)   // Solo Oboe ships only p/ff
        rr          1
        dyn_ctrl    cc1
        directional true
        notes       full
        vibrato      false
        vibrato_pair Leg
        legato_role  transition
    }
    {
        id          NVLegzero
        label       "Non-Vibrato Legato Re-trigger"
        kind        @Legato
        dynamics    (p mf ff)   // Solo Oboe p/ff; rr 2 in some sections
        rr          3
        dyn_ctrl    cc1
        directional false
        notes       full
        vibrato      false
        vibrato_pair Legzero
        legato_role  retrigger
        // The three vib-capable ensembles (2 Bassoons/2 Flutes/2 Oboes) ship
        // NO NVLegzero — their re-trigger set is Legzero only.
        instrument_filter (2cl "2 Clarinets" Saf Sba "Solo Bassoon" Sbc Sca
                           Scb Scl "Solo Clarinet" Sfl "Solo Flute"
                           Sob "Solo Oboe" Spi)
    }
    {
        // ADDITIONAL marcato-legato transition set (mf only, up/down zones
        // confirmed in the zone specs). The engine has no dedicated
        // marcato-legato route yet; declared as a plain transition so the
        // pack builder claims it — inert until the route exists.
        id          MLeg
        label       "Marcato Legato"
        kind        @Legato
        dynamics    (mf)
        rr          1
        dyn_ctrl    fixed   // single dynamic; CC1 irrelevant for selection
        directional true
        notes       full
        vibrato_pair ""     // recorded one way; no vib/NV pairing
        legato_role  transition
        // Absent from 2 Bassoons / 2 Flutes / 2 Oboes.
        instrument_filter (2cl "2 Clarinets" Saf Sba "Solo Bassoon" Sbc Sca
                           Scb Scl "Solo Clarinet" Sfl "Solo Flute"
                           Sob "Solo Oboe" Spi)
    }

    // ── Short Notes ──────────────────────────────────────────────────────────

    {
        id       Staccato
        label    Staccato
        kind     @Short
        dynamics (p mf ff)
        rr       3
        dyn_ctrl velocity
        notes    full
    }
    {
        id       Staccatissimo
        label    Staccatissimo
        kind     @Short
        dynamics (p mf ff)
        rr       4
        dyn_ctrl velocity
        notes    full
    }
    {
        id       Sfz
        label    Sforzando
        kind     @Short
        dynamics (mf f fff)
        rr       2
        dyn_ctrl velocity
        notes    full
    }
    {
        id       Repetitions
        label    Repetitions
        kind     @Short
        // Ensembles (2 Bassoons/2 Clarinets*/2 Flutes/2 Oboes) ship
        // pp/mp/f/fff; the solo instruments ship p/mf/ff. Spec lists the
        // ensemble set; missing combos resolve to None (same convention as
        // the CSS Spiccato per-section variance).
        dynamics (pp mp f fff)
        rr       6
        dyn_ctrl velocity
        notes    full
    }

    // ── Release Samples ──────────────────────────────────────────────────────
    // Triggered on note-off; layer selected by CC1 at the moment of note-off.
    // Single sample per note per dynamic (rr = 1).

    {
        id       Vibsusrel
        label    "Vibrato Sustain Release"
        kind     @Release
        dynamics (p mf ff)
        rr       1
        dyn_ctrl cc1
        notes    full
        instrument_filter (2ba "2 Bassoons" 2fl "2 Flutes" 2ob "2 Oboes"
                           Saf Sba "Solo Bassoon" Sca Sfl "Solo Flute"
                           Sob "Solo Oboe" Spi)
    }
    {
        id       NVsusrel
        label    "Non-Vibrato Sustain Release"
        kind     @Release
        dynamics (p mf ff)   // Solo Oboe ships only p/ff
        rr       1
        dyn_ctrl cc1
        notes    full
    }
    {
        id       Marcrel
        label    "Marcato Release"
        kind     @Release
        dynamics (mf fff)   // Solo Oboe additionally ships p
        rr       1
        dyn_ctrl cc1
        notes    full
    }
    {
        id       Fluttrel
        label    "Flutter Tongue Release"
        kind     @Release
        dynamics (p f)
        rr       1
        dyn_ctrl cc1
        notes    full
        instrument_filter (2fl "2 Flutes" Saf Sfl "Solo Flute" Spi)
    }
    {
        id       HTrel
        label    "Half-Tone Trill Release"
        kind     @Release
        dynamics (p mf ff)
        rr       1
        dyn_ctrl cc1
        notes    full
    }
    {
        id       WTrel
        label    "Whole-Tone Trill Release"
        kind     @Release
        dynamics (p mf ff)
        rr       1
        dyn_ctrl cc1
        notes    full
    }
)

// ── Legato Engine ─────────────────────────────────────────────────────────────
// Values from CSB_CSW_ENGINE.md — the REAL shipped KSP persistents, uniform
// across all 13 winds unless noted. Same CSS_W transition-over-sustain
// handoff as CSS: outgoing sustain fades (Fade old 800 ms), the transition
// plays for F.wait starting at a velocity-zone Offset, then fades out over
// Fade in (500 ms) while the incoming sustain fades in.
//
// F.wait (legtrans length) is PER-INSTRUMENT (no spec field yet — recorded
// here for when one lands):
//   2 Bassoons 1500 · 2 Clarinets 2500 · 2 Flutes 2500 · 2 Oboes 2000
//   Saf 1550 · Sbc 1650 · Sca 2500 · Scb 2150 · Solo Bassoon 1500
//   Solo Clarinet 2000 · Solo Flute 2300 · Solo Oboe 2000 · Spi 2000

legato_engine {
    // EXPRESSIVE MODE — the decoded Time A/B/C delay anchors (150/250/1500 ms,
    // uniform across all 13 winds). NOTE the direction is INVERTED vs CSS:
    // in CSW low velocity = fastest (150 ms), high velocity = slowest
    // (1500 ms — winds hold the transition much longer). Time D = 1500 ms for
    // intervals > 12 semitones has no zone slot — same value as zone C here.
    // (The manual's advertised 220/130/90 ms do NOT match the shipped
    // persistents; the decode wins.)
    expressive {
        enabled_cc58_range 6-10
        zones (
            {vel_range (0   64),  label fast,   delay_ms 150}
            {vel_range (65  100), label medium, delay_ms 250}
            {vel_range (101 127), label slow,   delay_ms 1500}
        )
    }

    // LOW LATENCY MODE — the decode found only ONE Time group per engine, so
    // no separate decoded LL set exists; these are the manual's LL values
    // (ASSUMPTION — revisit if an LL-specific persistent group is identified).
    low_latency {
        enabled_cc58_range 0-5
        zones (
            {vel_range (0  64),  label medium, delay_ms 90}
            {vel_range (65 127), label fast,   delay_ms 70}
        )
    }

    // NO portamento block: CSW ships no portamento samples (decoded:
    // Portamento vel max = n/a).

    // REPEATED NOTES (Legzero/NVLegzero) — same note re-struck while CC64
    // (sustain pedal) is held; 3 round robins.
    retrigger {
        trigger sustain_pedal_held
        rr      3
    }

    // Attack-velocity range splits ($eluxs/$0uhls) — shipped 64/100 for every
    // CSW instrument (script default is 64/85; real ship is 64/100).
    velocity_splits (64 100)

    // CSW has NO CSS-style 4-breakpoint IOI overlap-delay table — the Time
    // anchors above carry the whole delay, and a single 250 ms IOI timer
    // gates re-trigger vs legato. All anchors zeroed so the engine does not
    // fall back to the CSS-decoded defaults. (Thresholds kept at the CSS
    // shape; values are irrelevant with zero anchors.)
    overlap_delay {
        low_latency {
            soft { thresholds_ms (75 100 800 1100), anchors_ms (0 0 0 0) }
            loud { thresholds_ms (75 100 800 1100), anchors_ms (0 0 0 0) }
        }
        expressive {
            soft { thresholds_ms (200 300 800 800), anchors_ms (0 0 0 0) }
            loud { thresholds_ms (200 300 800 800), anchors_ms (0 0 0 0) }
        }
    }

    // LT sample-start offsets per attack-velocity zone — decoded 0/83/166,
    // uniform across all 13 winds. The decode gives one offset set per
    // engine, so the same bases apply to both modes (ASSUMPTION for the
    // per-mode split).
    lt_offset_expressive  (0 83 166)
    lt_offset_low_latency (0 83 166)

    // Fade out ($mhmq3) — the outgoing note's fade during the swap: decoded
    // 160–200 ms per instrument; 180 is the midpoint (2 Oboes = 160).
    transition_fade_ms   180
    // Fade in ($m0nme) = legtrans fade-OUT — 500 ms, uniform. Mapped to the
    // previous-transition retire fade, one value per velocity range.
    retire_transition_ms (500 500 500)
    // Fade old ($10utt/$qgkdl) — the outgoing sustain's fade: 800 ms, uniform.
    retire_sustain_ms    (800 800 800)

    // sustain_trim_db / fallback_velocity / skip_declick_ms / sustain_bloom_ms
    // left at engine defaults — no CSW-specific decode for these yet.
}

// ── Short Note Timing ─────────────────────────────────────────────────────────
// All short-note samples speak 60 ms before their rhythmic peak (manual,
// exact). Apply -60 ms track delay for on-grid playback.

short_note_timing {
    pre_delay_ms 60
}

// ── Keyswitch / CC58 Switching ────────────────────────────────────────────────
// Velocity-sensitive keyswitches; CC58 is the programmatic equivalent.
// Velocity sub-ranges are exact from the manual. CSW has NO Con Sordino and
// NO Portamento. CC58 31-45 and 56-60 are unassigned in CSW (CSB uses them
// for muted articulations).

keyswitch {
    velocity_sensitive true
    user_configurable  true

    cc58_map {
        0-5   "Sustain: Low Latency Legato"
        6-10  "Sustain: Expressive Legato"
        11-15 Repetitions
        16-20 Staccatissimo
        21-25 Staccato
        26-30 Sfz
        46-50 Trills
        51-55 "Flutter Tongue (flutes only)"
        61-65 "Measured Repetitions"
        66-70 "Marcato (no overlay)"
        71-75 "Marcato (with overlay)"
        76-80 "Legato On"
        81-85 "Legato Off"
    }

    // KS note assignments are user-configurable in CSW with NO documented
    // default layout — this layout is an ASSUMPTION mirroring the CSS
    // convention (low octave, C0 = MIDI 12, below every section's range).
    // Velocity maps are exact from the manual. Edit freely.
    notes (
        {
            note "C0"
            label "Sustain"
            vel_map {
                0-64   "NVsus+@legato-low"
                65-127 "NVsus+@legato-expressive"
            }
        }
        {
            note "C#0"
            label "Shorts"
            vel_map {
                0-32   "Repetitions"
                33-64  "Staccatissimo"
                65-96  "Staccato"
                97-127 "Sfz"
            }
        }
        {
            note "D#0"
            label "Trills"
            vel_map {
                0-64   "HTrills"
                65-127 "WTrills"
            }
        }
        {
            note "E0"
            label "Flutter"
            // Flutes/piccolo only — inert on other sections.
            vel_map { 0-127 "Flutter" }
        }
        {
            note "F#0"
            label "Marcato"
            // Manual: vel 0-64 = repetition overlay OFF, 65-127 = overlay ON.
            // The overlay mode has no engine token yet; both select Marcato.
            vel_map { 0-127 "Marcato" }
        }
        {
            note "G#0"
            label "Legato"
            vel_map {
                0-64   "@legato-off"
                65-127 "@legato-on"
            }
        }
        {
            note "A#0"
            label "Non-Vibrato"
            vel_map { 0-127 "NVsus+@novib" }
        }
    )
}
