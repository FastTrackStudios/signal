// Pacific - Solo Strings (Performance Samples, perf068) — engine config.
//
// Minimal config: sections + mics + performance; articulation declarations
// synthesized per pack by the builder (legslur_dn1_1, marcrel3, … suffixed
// ids). Three mic positions ship: Close, Ambient, Surround.
//
// Note ranges measured from the _patches zone maps (MIDI C4 = 60).

name    "Pacific - Solo Strings"
version "1.0"
vendor  "Performance Samples"

sections (
    {
        id           vln
        label        Violin
        lowest_note  G3
        highest_note E8
    }
    {
        id           vc
        label        Cello
        lowest_note  C2
        highest_note A6
    }
)

mics (
    {id Close,    label Close,    kind separate, default true}
    {id Ambient,  label Ambient,  kind separate}
    {id Surround, label Surround, kind separate}
)

performance {
    zone_pitch_tolerance 2
    attack_placement     start_at_tick
}
