// NI Essential Pianos (The Grandeur / Maverick / Gentleman / Giant) —
// zone classification and pack grouping. Consumed by
// `signal-sampler --example build_ni_packs`.
//
// These four ship one Kontakt script family ("NI ESSENTIAL PIANOS"), and its
// `script_3.ksp` names the engine's twelve sample groups:
//
//     0 DryTones   1 Release   2 Resonance  3 Repedal
//     4 Damper     5 Pedal     6 Hammer     7 SSR
//     8 Stringnoise 9 Pads    10 Repedal Loud 11 SoftPedal
//
// `zones.tsv` carries no group column, so we recover the group from the
// sample filename. Those names are library-specific in their *prefix*
// (GI_PP_SD / GI_MAV / GI_GMF / GI_K370) but consistent in their *keywords*,
// which is what we match on.

vendor "Native Instruments"

// First match wins — order matters. PEDALNOISE and PEDALPLUS must precede
// PEDAL, and DAMPUP/DAMPOFF must precede DAMPER, or the broader keyword
// swallows them. Matching is case-insensitive against the file's basename.
classify (
    {
        group "Release"
        match ("RELEASES" "RELEASE")
    }
    {
        group "Resonance"
        match ("RESO")
    }
    {
        group "SSR"
        match ("OVERTONE")
    }
    // The Gentleman spells its hammer-noise group GI_PP_BS_ rather than
    // HAMMER; same 88 zones, same role.
    {
        group "Hammer"
        match ("HAMMER" "_BS_")
    }
    {
        group "Stringnoise"
        match ("STRINGNOISE")
    }
    {
        group "Damper"
        match ("DAMPUP" "DAMPOFF" "DAMPER")
    }
    {
        group "Pedal"
        match ("PEDALNOISE" "PEDALPLUS" "PEDAL")
    }
)

// Everything the keywords do not claim is the dry body. The builder prints a
// per-group census every run so a library that breaks this assumption shows
// up as a body count that moved, rather than as silence in a pack.
default_group "DryTones"

// One .signalpack per entry. The split is a RAM decision, not a musical one:
// the piano pack is everything you need to play a note, the resonance pack is
// the pedal-down sympathetic layer — ~30% of the zones, and inaudible until
// someone puts a foot down, so it loads on demand.
packs (
    {
        name   "Piano"
        groups ("DryTones" "Release" "Hammer" "Damper" "Pedal" "Stringnoise")
    }
    {
        name   "Resonance"
        groups ("Resonance" "SSR")
    }
)

// `dir` is under /run/media/AudioHaven/Sampled/Keys, `instrument` is the
// subdirectory holding zones.tsv + the .ksp dumps.
libraries (
    {
        dir        "The Grandeur Library"
        instrument "The Grandeur"
        name       "The Grandeur"
    }
    {
        dir        "The Maverick"
        instrument "The Maverick"
        name       "The Maverick"
    }
    {
        dir        "The Gentleman Library"
        instrument "The Gentleman"
        name       "The Gentleman"
    }
    {
        dir        "The Giant"
        instrument "The Giant"
        name       "The Giant"
    }
    {
        dir        "The Giant"
        instrument "The Giant - Cinematic"
        name       "The Giant Cinematic"
    }
)
