// A live guitar-rig profile for the standalone Signal rig.
//
// Each patch is a named tone whose chain is an ordered list of blocks. A block
// has a `block_type` (what it is) and a realization (how it's built):
//   { block_type @Amp,     nam amps/clean.nam }     // Amp realized by a NAM model
//   { block_type @Drive,   nam pedals/ts808.nam }   // any nonlinear block can be NAM
//   { block_type @Cabinet, ir cabs/v30.wav }        // cabinet impulse response
//   { block_type @Delay,   plugin /lib/clap/Echo.clap }  // hosted CLAP/VST3
//                  // optional `state_b64 "..."` restores saved plugin params
// An empty realization (no nam/ir/plugin) is a placeholder block. Switching
// patches at runtime is instant + click-free (every chain is pre-loaded).
//
// Paths are relative to THIS file's directory (or absolute). Edit them to point
// at your own models/IRs, then run:
//
//   cargo run -p signal-sampler --example worship_rig -- crates/signal-sampler/examples/worship.styx

name Worship
default_patch 0
patches (
    {
        name Clean
        chain (
            { block_type @Amp, nam amps/clean_twin.nam }
            { block_type @Cabinet, ir cabs/twin_jensen.wav }
        )
        input_trim_db 0.0
        output_trim_db 0.0
    }
    {
        name Crunch
        chain (
            { block_type @Amp, nam amps/crunch_ac30.nam }
            { block_type @Cabinet, ir cabs/greenback.wav }
        )
        output_trim_db -1.0
    }
    {
        name Lead
        // drive pedal → amp → cab
        chain (
            { block_type @Drive, nam amps/ts808.nam }
            { block_type @Amp, nam amps/lead_boost.nam }
            { block_type @Cabinet, ir cabs/v30.wav }
        )
        input_trim_db 3.0
        output_trim_db -2.0
    }
    {
        name Ambient
        chain (
            { block_type @Amp, nam amps/ambient_clean.nam }
            { block_type @Cabinet, ir cabs/twin_jensen.wav }
        )
    }
)
