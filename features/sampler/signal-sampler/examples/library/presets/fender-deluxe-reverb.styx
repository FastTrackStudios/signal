// Fender Deluxe Reverb — ML Sound Lab full-rig NAM captures (amp + cab baked in).
// Each scene is an Amp block whose NAM model is the maker's full-rig capture.
name "Fender Deluxe Reverb"
vendor "ML Sound Lab"
category "Clean Combo"
default_scene 0
scenes (
    {
        name Clean
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Fender Deluxe Reverb/Full Rig/ML FNDR Deluxe Clean FULL.nam" } )
    }
    {
        name Drive
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Fender Deluxe Reverb/Full Rig/ML FNDR Deluxe Drive FULL.nam" } )
    }
    {
        name Overdrive
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Fender Deluxe Reverb/Full Rig/ML FNDR Deluxe Overdrive FULL.nam" } )
    }
)
