// Marshall JCM800 — ML Sound Lab full-rig NAM captures (amp + cab baked in).
// Each scene is an Amp block whose NAM model is the maker's full-rig capture.
name "Marshall JCM800"
vendor "ML Sound Lab"
category "Rock"
default_scene 0
scenes (
    {
        name Clean
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Marshall JCM800/Full Rig/ML MARS 800 Clean FULL.nam" } )
    }
    {
        name Drive
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Marshall JCM800/Full Rig/ML MARS 800 Drive FULL.nam" } )
    }
    {
        name Lead
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Marshall JCM800/Full Rig/ML MARS 800 Lead FULL.nam" } )
    }
)
