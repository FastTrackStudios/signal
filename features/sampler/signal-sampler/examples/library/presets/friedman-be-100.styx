// Friedman BE-100 — ML Sound Lab full-rig NAM captures (amp + cab baked in).
// Each scene is an Amp block whose NAM model is the maker's full-rig capture.
name "Friedman BE-100"
vendor "ML Sound Lab"
category "Hi-Gain"
default_scene 0
scenes (
    {
        name Drive
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Friedman BE-100/Full Rig/ML FMAN BE Drive FULL.nam" } )
    }
    {
        name Plexi
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Friedman BE-100/Full Rig/ML FMAN BE Plexi FULL.nam" } )
    }
    {
        name Lead
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Friedman BE-100/Full Rig/ML FMAN HBE Lead FULL.nam" } )
    }
)
