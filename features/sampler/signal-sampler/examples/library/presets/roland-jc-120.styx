// Roland JC-120 — ML Sound Lab full-rig NAM captures (amp + cab baked in).
// Each scene is an Amp block whose NAM model is the maker's full-rig capture.
name "Roland JC-120"
vendor "ML Sound Lab"
category "Clean Combo"
default_scene 0
scenes (
    {
        name Clean
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Roland Jazz Chorus JC-120/Full Rig/ML JAZZ 120 Clean FULL.nam" } )
    }
    {
        name Drive
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Roland Jazz Chorus JC-120/Full Rig/ML JAZZ 120 Drive FULL.nam" } )
    }
    {
        name Overdrive
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Roland Jazz Chorus JC-120/Full Rig/ML JAZZ 120 Overdrive FULL.nam" } )
    }
)
