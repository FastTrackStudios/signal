// Vox AC30 — ML Sound Lab full-rig NAM captures (amp + cab baked in).
// Each scene is an Amp block whose NAM model is the maker's full-rig capture.
name "Vox AC30"
vendor "ML Sound Lab"
category "Chime"
default_scene 0
scenes (
    {
        name Clean
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Vox AC30/Full Rig/ML VX30 1964 Clean FULL.nam" } )
    }
    {
        name Drive
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Vox AC30/Full Rig/ML VX30 1964 Drive FULL.nam" } )
    }
    {
        name Overdrive
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Vox AC30/Full Rig/ML VX30 1964 Overdrive FULL.nam" } )
    }
)
