// Orange Rockerverb — ML Sound Lab full-rig NAM captures (amp + cab baked in).
// Each scene is an Amp block whose NAM model is the maker's full-rig capture.
name "Orange Rockerverb"
vendor "ML Sound Lab"
category "Rock"
default_scene 0
scenes (
    {
        name Clean
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Orange Rockerverb/Full Rig/ML ORNG Rock Clean FULL.nam" } )
    }
    {
        name Drive
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Orange Rockerverb/Full Rig/ML ORNG Rock Drive FULL.nam" } )
    }
    {
        name Lead
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Orange Rockerverb/Full Rig/ML ORNG Rock Lead FULL.nam" } )
    }
)
