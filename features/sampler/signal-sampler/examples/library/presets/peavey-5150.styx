// Peavey 5150 — ML Sound Lab full-rig NAM captures (amp + cab baked in).
// Each scene is an Amp block whose NAM model is the maker's full-rig capture.
name "Peavey 5150"
vendor "ML Sound Lab"
category "Metal"
default_scene 0
scenes (
    {
        name Clean
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Peavey 5150/Full Rig/ML PEAV Block Clean FULL.nam" } )
    }
    {
        name Drive
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Peavey 5150/Full Rig/ML PEAV Block Drive FULL.nam" } )
    }
    {
        name Lead
        chain ( { block_type @Amp, nam "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Peavey 5150/Full Rig/ML PEAV Block Lead FULL.nam" } )
    }
)
