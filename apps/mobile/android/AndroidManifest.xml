<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The engine is on the network (the emulator reaches the host at
         10.0.2.2), over plain ws on the LAN. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:hasCode="true" android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:allowNativeHeapPointerTagging="false"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <!-- Locked to landscape: the phone layout is a phone held sideways. -->
        <activity android:configChanges="orientation|screenLayout|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:label="@string/app_name" android:launchMode="singleTask"
            android:name="dev.dioxus.main.MainActivity">
            <meta-data android:name="android.app.lib_name" android:value="main" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
