# TONE3000 — copy to `.env` and fill in. `.envrc` loads it into the dev
# shell, so `cargo run` and `cargo build` both see these.
#
# Get a key: tone3000.com → Settings → API Keys → Create API Key.

# The OAuth client_id. NOT a secret — TONE3000 documents it as safe for
# client-side code, which is the whole point of PKCE: a distributed app
# proves itself with a per-request challenge instead of a shipped secret.
SIGNAL_T3K_PUBLISHABLE_KEY=t3k_pub_...

# Where the authorization redirects back to. The default is
# http://localhost:4040/tone3000/callback — the engine's own HTTP server.
# Only set this if the engine is not on :4040, or to use a relay.
#SIGNAL_T3K_REDIRECT_URI=http://localhost:4040/tone3000/callback

# There is deliberately NO secret-key variable here. This integration
# uses OAuth 2.0 + PKCE and has no server to keep a secret on: a
# `t3k_cs_…` key in a desktop app, a plugin, or a browser bundle is a
# key you have published. If a flow ever needs one, it needs a server
# first.
